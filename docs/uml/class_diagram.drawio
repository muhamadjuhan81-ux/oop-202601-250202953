<mxfile host="app.diagrams.net">
  <diagram name="Halaman-1" id="ID77o2sAvhWAvk5a148b">
    <mxGraphModel dx="2603" dy="1510" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="light-dark(#ffffff, #121212)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\npackage kontrak {\n    interface DapatDipinjam {\n        +bisaDipinjam(): boolean\n    }\n    interface AturanDenda {\n        +hitung(aset: Aset, hariTerlambat: int): long\n    }\n}\n\npackage model {\n    abstract class Aset {\n        -kode: String\n        -nama: String\n        -status: StatusAset\n        -kondisi: Kondisi\n        +Aset(kode: String, nama: String)\n        +getKode(): String\n        +getNama(): String\n        +getStatus(): StatusAset\n        +getKondisi(): Kondisi\n        +setNama(nama: String): void\n        +setStatus(status: StatusAset): void\n        +setKondisi(kondisi: Kondisi): void\n        +bisaDipinjam(): boolean\n        +getJenis(): JenisAset\n        {abstract} +hitungDenda(hariTerlambat: int): long\n    }\n    class AlatLab {\n        -laboratorium: String\n        -tingkatRisiko: TingkatRisiko\n        +getLaboratorium(): String\n        +getTingkatRisiko(): TingkatRisiko\n        +getJenis(): JenisAset\n        +hitungDenda(hariTerlambat: int): long\n    }\n    class Laptop {\n        -spesifikasi: String\n        -nomorInventaris: String\n        +getSpesifikasi(): String\n        +getNomorInventaris(): String\n        +getJenis(): JenisAset\n        +hitungDenda(hariTerlambat: int): long\n    }\n    class Ruang {\n        -kapasitas: int\n        +getKapasitas(): int\n        +getJenis(): JenisAset\n        +hitungDenda(hariTerlambat: int): long\n    }\n    class Peminjaman {\n        -aset: Aset\n        -peminjam: String\n        -mulai: LocalDateTime\n        -selesai: LocalDateTime\n        -status: StatusPeminjaman\n        +Peminjaman(aset: Aset, peminjam: String, mulai: LocalDateTime, selesai: LocalDateTime)\n        +getAset(): Aset\n        +getPeminjam(): String\n        +getStatus(): StatusPeminjaman\n        +bentrokDengan(lain: Peminjaman): boolean\n    }\n    enum StatusAset {\n        TERSEDIA\n        DIPINJAM\n        RUSAK\n    }\n    enum Kondisi {\n        BAIK\n        RUSAK_RINGAN\n        RUSAK_BERAT\n    }\n    enum JenisAset {\n        RUANG\n        LAPTOP\n        ALAT_LAB\n    }\n    enum TingkatRisiko {\n        RENDAH\n        SEDANG\n        TINGGI\n    }\n    enum StatusPeminjaman {\n        DIAJUKAN\n        DISETUJUI\n        DITOLAK\n        DIPINJAM\n        DIKEMBALIKAN\n        TERLAMBAT\n        DIBATALKAN\n    }\n}\n\npackage katalog {\n    class KatalogAset {\n        -daftar: List&lt;Aset&gt;\n        +tambah(aset: Aset): void\n        +semua(): List&lt;Aset&gt;\n        +cari(kata: String): List&lt;Aset&gt;\n        +cari(kata: String, jenis: JenisAset): List&lt;Aset&gt;\n        -namaMemuat(aset: Aset, kata: String): boolean\n    }\n}\n\npackage jadwal {\n    class JadwalPeminjaman {\n        -daftar: List&lt;Peminjaman&gt;\n        +ajukan(baru: Peminjaman): boolean\n    }\n}\n\npackage denda {\n    class DendaFlat {\n        +hitung(aset: Aset, hariTerlambat: int): long\n    }\n    class DendaProgresif {\n        +hitung(aset: Aset, hariTerlambat: int): long\n    }\n}\n\npackage config {\n    class Varian &lt;&lt;final&gt;&gt; {\n        {static} -aktif: Varian\n        +nim: String\n        +nama: String\n        +dendaPerHari: int\n        +batasDurasiJam: int\n        +kuotaLaptop: int\n        {static} +dariNim(nim: String, nama: String): Varian\n        {static} +aktif(): Varian\n    }\n}\n\nAset ..|&gt; DapatDipinjam\nAset &lt;|-- AlatLab\nAset &lt;|-- Laptop\nAset &lt;|-- Ruang\nDendaFlat ..|&gt; AturanDenda\nDendaProgresif ..|&gt; AturanDenda\n\nKatalogAset o-- \&quot;0..*\&quot; Aset : daftar\nJadwalPeminjaman *-- \&quot;0..*\&quot; Peminjaman : daftar\nPeminjaman --&gt; \&quot;1\&quot; Aset : aset\nPeminjaman --&gt; \&quot;1\&quot; StatusPeminjaman : status\nAset --&gt; \&quot;1\&quot; StatusAset\nAset --&gt; \&quot;1\&quot; Kondisi\nAlatLab --&gt; \&quot;1\&quot; TingkatRisiko\nAset ..&gt; JenisAset\nAlatLab ..&gt; Varian\nLaptop ..&gt; Varian\nRuang ..&gt; Varian\nDendaFlat ..&gt; Aset\nDendaProgresif ..&gt; Aset\nAturanDenda ..&gt; Aset\nKatalogAset ..&gt; JenisAset\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ssq5sAn6xIsLpm_KEdaC-1">
